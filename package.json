{
  "private": true,
  "scripts": {
    "build:js": "esbuild src/ts/init.ts --bundle --format=iife --outfile=static/js/app.js --keep-names",
    "build:css": "sass src/scss/main.scss static/css/app.css --no-source-map --style=compressed",
    "build": "npm run build:js && npm run build:css",
    "check": "tsc --noEmit && npm run build"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "sass": "^1.98.0",
    "typescript": "^5.7.0"
  }
}
